  <remote name="dukeoftoad" fetch="https://github.com/dukeoftoad" />

  <!-- Device tree: VoltageOS 5.11-EOL (A16 QPR2) continuation -->
  <project path="device/xiaomi/veux" name="device_xiaomi_veux" remote="dukeoftoad" revision="sixteen-qpr2" />

  <!-- Kernel source (SM6375 / blair) -->
  <project path="kernel/xiaomi/sm6375" name="kernel_xiaomi_sm6375" remote="dukeoftoad" revision="16.2" />

